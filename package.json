{
  "name": "peremena",
  "version": "0.1.0",
  "private": true,
  "description": "Перемена — мессенджер для общения внутри школы",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:push": "node scripts/db-push.mjs",
    "db:seed": "node scripts/db-seed.mjs",
    "test": "npm run test:unit",
    "test:unit": "node --experimental-strip-types --import ./tests/ts-resolver.mjs --test \"tests/*.test.mts\"",
    "test:api": "node --test \"tests/*.test.mjs\""
  },
  "dependencies": {
    "next": "^15.5.4",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "typescript": "^5.8.3"
  }
}
