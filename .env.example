# Строка подключения к Postgres (Neon, Vercel Postgres, Supabase или свой сервер).
# Для Neon берите адрес с суффиксом -pooler.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Секрет для подписи сессионных кук. Сгенерировать:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="замените-на-случайную-строку-минимум-32-символа"

# Закрытый режим: регистрация только по коду-приглашению.
# Сейчас выключено — регистрация свободная. Поставьте "true", чтобы закрыть круг.
INVITE_ONLY="false"

# Username первого администратора. Этот аккаунт получит роль admin при регистрации.
ADMIN_USERNAME=""

# Сколько регистраций в час разрешено с одного IP-адреса.
# Школа обычно выходит в сеть через один общий адрес, поэтому порог высокий:
# иначе класс, регистрирующийся на одном уроке, заблокирует сам себя.
REGISTRATION_LIMIT="60"
